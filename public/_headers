# Cloudflare reads this file as configuration; it is not served as an asset.
#
# The site has no browser JavaScript, cookies or third-party resources. Its
# one Worker endpoint accepts the contact form and sends plain-text email; the
# policy below keeps everything else local and blocks every other code path.

/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), interest-cohort=()

# Assets change rarely and are not content-hashed, so cache for a day rather
# than a year — long enough to matter, short enough to correct a mistake.
#
# Listed one by one rather than as /*.png. Wildcard matching is documented for
# Pages but not confirmed for Workers static assets, and a pattern that
# silently fails to match would leave these assets with no caching at all —
# the exact failure that was already sitting in this file. Nine explicit rules
# against a limit of 100 is a cheap way to be certain.
/styles.css
  Cache-Control: public, max-age=86400

/share.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

# The diagram artwork. These are masks, not pictures: on their own they are
# white-on-black shapes with no colour and no context, and they are meant to be
# seen inside the three-circles diagram rather than as separate files.
# noimageindex keeps them out of image search — the one route by which someone
# would otherwise arrive at one on its own.
#
# Spelled out one by one for the same reason as the rules above: a wildcard
# that silently fails to match on Workers static assets would drop both the
# caching AND the noindex, and the second failure would be invisible.
#
# Being straight about the limit: this stops them being surfaced and indexed,
# and the site never links to one or opens it in a tab. It cannot stop someone
# who requests the URL directly — a browser has to download an image to draw
# it. See docs/IMAGES.md.
/images/logo-wide.png
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex, noimageindex

/images/self-figure.png
  Cache-Control: public, max-age=86400
