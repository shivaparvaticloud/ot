# Cloudflare reads this file as configuration; it is not served as an asset.
#
# The site is static, has no JavaScript, no forms, no cookies, no backend and
# no third-party resources. The policy below is written to keep it that way:
# if any future change tries to load an external script, font, frame or
# tracker, the browser refuses it rather than failing quietly.

/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), interest-cohort=()

# Assets change rarely and are not content-hashed, so cache for a day rather
# than a year — long enough to matter, short enough to correct a mistake.
/styles.css
  Cache-Control: public, max-age=86400

/share.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

# The diagram artwork. These are masks, not pictures: on their own they are
# white-on-black shapes with no context, and they are meant to be seen inside
# the three-circles diagram rather than as separate files. noimageindex keeps
# them out of image search, which is the one route by which someone would
# arrive at one on its own.
#
# Worth being straight about the limit here: this stops the images being
# surfaced and indexed, and the site never links to them or opens them in a
# tab. It cannot stop someone who requests the URL directly — a browser has to
# be able to download an image in order to draw it. See docs/IMAGES.md.
/images/*
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex, noimageindex
