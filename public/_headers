# Cloudflare reads this file as configuration; it is not served as an asset.
#
# The site is static, has no JavaScript, no forms, no cookies, no backend and
# no third-party resources. The policy below is written to keep it that way:
# if any future change tries to load an external script, font, frame or
# tracker, the browser refuses it rather than failing quietly.

/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), interest-cohort=()

# Assets change rarely and are not content-hashed, so cache for a day rather
# than a year — long enough to matter, short enough to correct a mistake.
#
# Listed one by one rather than as /*.png. Wildcard matching is documented for
# Pages but not confirmed for Workers static assets, and a pattern that
# silently fails to match would leave these assets with no caching at all —
# the exact failure that was already sitting in this file. Nine explicit rules
# against a limit of 100 is a cheap way to be certain.
/styles.css
  Cache-Control: public, max-age=86400

/share.png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/logo-wide-240.png
  Cache-Control: public, max-age=86400

/logo-wide-240.webp
  Cache-Control: public, max-age=86400

/logo-wide-480.png
  Cache-Control: public, max-age=86400

/logo-wide-480.webp
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
